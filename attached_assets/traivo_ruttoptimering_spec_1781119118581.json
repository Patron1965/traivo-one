  "systemöversikt": {
    "syfte": "Hantera stora mängder uppgifter (flera tusen samtidigt) och omvandla dessa till praktiskt genomförbara arbetsplaner för produktionsteam.",
    "omfattning": "Tvåstegsoptimering: strategisk grovplanering följt av operativ veckoplanering med dynamisk omplanering i realtid.",
    "mål": [
      "Optimera kundens önskade leveranstid",
      "Minimera restider genom geografisk närhet",
      "Balansera tillgängliga resurser",
      "Hantera arbetstider och tidsfönster",
      "Maximera ekonomisk effektivitet",
      "Kontinuerligt optimera utifrån verkliga förhållanden"
    ],
    "nivåer": {
      "strategisk": {
        "namn": "Grovplanering",
        "frågor": [
          "Var skall vi vara nästa vecka?",
          "Vilken ort har störst tyngdpunkt?",
          "Hur mycket produktion finns?",
          "Hur ser kapacitetsutnyttjandet ut?"
        ]
      },
      "operativ": {
        "namn": "Veckoplanering",
        "frågor": [
          "Vilken dag skall jobbet utföras?",
          "I vilken ordning skall jobben göras?",
          "Hur lång blir restiden?",
          "Hur påverkas veckan av förändringar?"
        ]
      }
    }
  },
